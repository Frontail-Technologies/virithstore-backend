# Server
NODE_ENV=development
BACKEND_PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/virithstore
CORS_ORIGIN=http://localhost:3000
# Public URL of the storefront (PayWay redirects here). Required in production.
FRONTEND_URL=http://localhost:3000

# Secrets (required, 32+ characters each; e.g. `openssl rand -hex 32`). The server refuses to start without them.
JWT_SECRET=replace_with_a_random_secret_of_32_plus_chars
# Must match OAUTH_SHARED_SECRET in the frontend .env.local
OAUTH_SHARED_SECRET=replace_with_a_different_random_secret_32_plus_chars

# ABA PayWay (all four required in production; development defaults to the sandbox URLs below)
PAYWAY_MERCHANT_KEY=
PAYWAY_PUBLIC_KEY=
# Sandbox: https://checkout-sandbox.payway.com.kh   Production: https://checkout.payway.com.kh
PAYWAY_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
PAYWAY_CHECK_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/check-transaction-2

# Image uploads (Cloudinary; without it uploads fall back to local disk in development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram login (optional; login with Telegram is disabled when empty)
TELEGRAM_BOT_TOKEN=
